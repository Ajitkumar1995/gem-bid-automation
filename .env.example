DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0

# Password reset email (leave EMAIL_HOST empty to print reset emails locally)
DEFAULT_FROM_EMAIL=GeM Bid Workspace <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Bid workspace defaults (administrator can override these in Django Admin)
DEFAULT_ACTIVE_BID_LIMIT=1
ACTIVE_BID_EXPIRY_DAYS=30

# Production security
DJANGO_SECURE_SSL_REDIRECT=0
